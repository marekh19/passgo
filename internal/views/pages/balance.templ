package pages

// Balance is a replaceable fragment for live balance updates.
templ Balance(pv PlayerView) {
	<section id="balance" class="pt-8 pb-6 text-center">
		<div class="flex items-center justify-center gap-2">
			<h1 class="text-xl font-semibold">{ pv.Me.Name }</h1>
			if pv.IsAdmin {
				<span class="rounded-full bg-amber-500/15 text-amber-400 px-2 py-0.5 text-xs font-medium">Admin</span>
			}
		</div>
		<p class="mt-1 text-6xl font-black tabular-nums tracking-tight">{ dollars(pv.Me.Balance) }</p>
		<p class="mt-2 text-sm text-neutral-500">
			Game <span class="font-medium text-neutral-300">{ pv.Code }</span> · { playerCountLabel(pv.PlayerCount) }
		</p>
	</section>
}
