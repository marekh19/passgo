package pages

import "github.com/marekh19/passgo/internal/views"

templ Join(code string, started bool) {
	@views.Layout("Join " + code) {
		<div class="py-8">
			if started {
				<h1 class="text-2xl font-semibold">Game { code } already started</h1>
				<p class="mt-4">You cannot join a game in progress.</p>
			} else {
				<h1 class="text-2xl font-semibold">Join game { code }</h1>
				<form method="post" action={ templ.SafeURL("/api/sessions/" + code + "/join") } class="mt-6 flex flex-col gap-3">
					<label for="name">Your name</label>
					<input id="name" name="name" required maxlength="20" autocomplete="name" class="h-12 rounded bg-neutral-900 px-3"/>
					<button type="submit" class="h-12 rounded bg-collect font-semibold">Join game</button>
				</form>
			}
			<a href="/" class="mt-6 inline-block underline">Back home</a>
		</div>
	}
}
